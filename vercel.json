{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "apps/backend",
      "framework": "express"
    },
    "vite-project": {
      "root": "apps/frontend/vite-project",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/app/index.html" }]
    },
    "landing": {
      "root": "apps/landing",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/app/:path*", "destination": { "service": "vite-project" } },
    { "source": "/(.*)", "destination": { "service": "landing" } }
  ]
}